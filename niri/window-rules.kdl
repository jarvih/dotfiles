// Window rules let you adjust behavior for individual windows.
// Included from config.kdl.
//
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Window-Rules
//
// Order matters: rules are applied top to bottom, and later rules override
// earlier ones for the same window. Keep them all in this file so the ordering
// stays obvious.

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Microsoft Edge opens as a maximized column: fills the working area, but keeps
// waybar and the struts visible (unlike open-fullscreen, which covers the output).
// This only applies as the window opens; resizing or un-maximizing afterwards
// sticks, since open-* properties are not continuously enforced.
//
// The app-id is anchored on purpose: the Edge PWAs use their own app-ids of the
// form "msedge-<id>-Default" (Outlook and friends), and should not be caught here.
// Do not try to match on the title instead: Edge puts a zero-width space in it
// ("Microsoft​ Edge"), so the obvious title regex never matches.
window-rule {
    match app-id="^microsoft-edge$"
    open-maximized true
}

window-rule {
    match app-id="^$" title="^$"
    open-floating true
}

// Rounded corners for all windows.
window-rule {
    geometry-corner-radius 3
    clip-to-geometry true
}

// Make password managers open as floating windows, since they are small utility windows.
// The last two matches are the Bitwarden Edge extension popup: the exact app-id,
// plus a fallback in case the extension id or Edge profile changes.
window-rule {
    match app-id="^bitwarden$"
    match app-id="^org.keepassxc.KeePassXC$"
    match app-id="^msedge-jbkfoedolllekgbhcbcoahefnbanhhlh-Default$"
    match app-id="^msedge-" title="^Bitwarden$"
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 900; }
}

// Make calculator open as a floating window, since it is a small utility window.
window-rule {
    match app-id="org.gnome.Calculator"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}
